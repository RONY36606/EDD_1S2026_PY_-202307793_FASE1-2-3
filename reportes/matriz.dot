digraph Matriz {
    rankdir=LR;
    bgcolor="#040d14";
    node [fontname="Courier", fontsize=11, style=filled, margin="0.2"];
    edge [fontname="Courier", fontsize=9];
    splines=false;
    // Fabricantes
    { rank=min;
        fab_BuenaVidaGT [label="BuenaVidaGT", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_DeTodo [label="DeTodo", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_GenericLab [label="GenericLab", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_LabFarma [label="LabFarma", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_MediSupplyGT [label="MediSupplyGT", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
    }
    // Proveedores
    prov_Benito_proveedor [label="Benito proveedor", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    prov_Juanito_proveedor [label="Juanito proveedor", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    // Celdas
    val_Benito_proveedor_BuenaVidaGT [label="40", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Benito_proveedor_DeTodo [label="20000", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Benito_proveedor_GenericLab [label="5500", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Juanito_proveedor_LabFarma [label="5000", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Juanito_proveedor_MediSupplyGT [label="50025", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    // Conexiones horizontales (proveedor -> cantidad)
    prov_Benito_proveedor -> val_Benito_proveedor_BuenaVidaGT [color="#00ffe7", style=solid];
    prov_Benito_proveedor -> val_Benito_proveedor_DeTodo [color="#00ffe7", style=solid];
    prov_Benito_proveedor -> val_Benito_proveedor_GenericLab [color="#00ffe7", style=solid];
    prov_Juanito_proveedor -> val_Juanito_proveedor_LabFarma [color="#00ffe7", style=solid];
    prov_Juanito_proveedor -> val_Juanito_proveedor_MediSupplyGT [color="#00ffe7", style=solid];
    // Conexiones verticales (fabricante -> cantidad)
    fab_BuenaVidaGT -> val_Benito_proveedor_BuenaVidaGT [color="#f5e642", style=dashed];
    fab_DeTodo -> val_Benito_proveedor_DeTodo [color="#f5e642", style=dashed];
    fab_GenericLab -> val_Benito_proveedor_GenericLab [color="#f5e642", style=dashed];
    fab_LabFarma -> val_Juanito_proveedor_LabFarma [color="#f5e642", style=dashed];
    fab_MediSupplyGT -> val_Juanito_proveedor_MediSupplyGT [color="#f5e642", style=dashed];
}