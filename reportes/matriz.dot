digraph Matriz {
    rankdir=LR;
    bgcolor="#040d14";
    node [fontname="Courier", fontsize=11, style=filled, margin="0.2"];
    edge [fontname="Courier", fontsize=9];
    splines=false;
    // Fabricantes
    { rank=min;
        fab_ACME_S_A_ [label="ACME S.A.", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_CardioTech [label="CardioTech", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_DeTodo [label="DeTodo", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_MediFlow [label="MediFlow", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_SafeMed [label="SafeMed", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
        fab_UltraMed [label="UltraMed", shape=rectangle, fillcolor="#1a1500", color="#f5e642", fontcolor="#f5e642"];
    }
    // Proveedores
    prov_Camerun_Sal [label="Camerun Sal", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    prov_Juanito_Maravilla [label="Juanito Maravilla", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    prov_Monito_Dinamita [label="Monito Dinamita", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    prov_Pedrito_Alcachofa [label="Pedrito Alcachofa", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    prov_Tercio_Casi [label="Tercio Casi", shape=rectangle, fillcolor="#071520", color="#00ffe7", fontcolor="#00ffe7"];
    // Celdas
    val_Camerun_Sal_DeTodo [label="9", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Camerun_Sal_MediFlow [label="5000", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Camerun_Sal_UltraMed [label="375", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Juanito_Maravilla_ACME_S_A_ [label="9458", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Monito_Dinamita_MediFlow [label="510", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Monito_Dinamita_SafeMed [label="690", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Pedrito_Alcachofa_DeTodo [label="2520", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Pedrito_Alcachofa_MediFlow [label="128", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Tercio_Casi_ACME_S_A_ [label="4000", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Tercio_Casi_CardioTech [label="504", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    val_Tercio_Casi_DeTodo [label="2515", shape=circle, fillcolor="#001a0d", color="#00ff88", fontcolor="#00ff88", width=0.8];
    // Conexiones horizontales (proveedor -> cantidad)
    prov_Camerun_Sal -> val_Camerun_Sal_DeTodo [color="#00ffe7", style=solid];
    prov_Camerun_Sal -> val_Camerun_Sal_MediFlow [color="#00ffe7", style=solid];
    prov_Camerun_Sal -> val_Camerun_Sal_UltraMed [color="#00ffe7", style=solid];
    prov_Juanito_Maravilla -> val_Juanito_Maravilla_ACME_S_A_ [color="#00ffe7", style=solid];
    prov_Monito_Dinamita -> val_Monito_Dinamita_MediFlow [color="#00ffe7", style=solid];
    prov_Monito_Dinamita -> val_Monito_Dinamita_SafeMed [color="#00ffe7", style=solid];
    prov_Pedrito_Alcachofa -> val_Pedrito_Alcachofa_DeTodo [color="#00ffe7", style=solid];
    prov_Pedrito_Alcachofa -> val_Pedrito_Alcachofa_MediFlow [color="#00ffe7", style=solid];
    prov_Tercio_Casi -> val_Tercio_Casi_ACME_S_A_ [color="#00ffe7", style=solid];
    prov_Tercio_Casi -> val_Tercio_Casi_CardioTech [color="#00ffe7", style=solid];
    prov_Tercio_Casi -> val_Tercio_Casi_DeTodo [color="#00ffe7", style=solid];
    // Conexiones verticales (fabricante -> cantidad)
    fab_ACME_S_A_ -> val_Juanito_Maravilla_ACME_S_A_ [color="#f5e642", style=dashed];
    fab_ACME_S_A_ -> val_Tercio_Casi_ACME_S_A_ [color="#f5e642", style=dashed];
    fab_CardioTech -> val_Tercio_Casi_CardioTech [color="#f5e642", style=dashed];
    fab_DeTodo -> val_Camerun_Sal_DeTodo [color="#f5e642", style=dashed];
    fab_DeTodo -> val_Pedrito_Alcachofa_DeTodo [color="#f5e642", style=dashed];
    fab_DeTodo -> val_Tercio_Casi_DeTodo [color="#f5e642", style=dashed];
    fab_MediFlow -> val_Camerun_Sal_MediFlow [color="#f5e642", style=dashed];
    fab_MediFlow -> val_Monito_Dinamita_MediFlow [color="#f5e642", style=dashed];
    fab_MediFlow -> val_Pedrito_Alcachofa_MediFlow [color="#f5e642", style=dashed];
    fab_SafeMed -> val_Monito_Dinamita_SafeMed [color="#f5e642", style=dashed];
    fab_UltraMed -> val_Camerun_Sal_UltraMed [color="#f5e642", style=dashed];
}